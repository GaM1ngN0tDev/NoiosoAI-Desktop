<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NoiosoAI_Desktop.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="40,24,40,40" Spacing="28" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Appearance -->
            <StackPanel Spacing="8">
                <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="ThemeBox" Header="Theme" Width="260"
                          SelectionChanged="ThemeBox_SelectionChanged">
                    <ComboBoxItem Content="Use system setting" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </StackPanel>

            <!-- Server -->
            <StackPanel Spacing="8">
                <TextBlock Text="Ollama server" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox x:Name="IpBox" Header="Server IP address" />
                <TextBox x:Name="PortBox" Header="Server port" />
                <Button Content="Save &amp; Connect" Style="{StaticResource AccentButtonStyle}"
                        Click="Save_Click" />
                <InfoBar x:Name="SavedBar" Severity="Success" IsOpen="False"
                         Message="Saved. Go back to Chat to reconnect." />
            </StackPanel>

            <!-- Personalities -->
            <StackPanel Spacing="8">
                <TextBlock Text="Personalities" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="PersonaBox" Header="Personality" Width="260"
                          SelectionChanged="PersonaBox_SelectionChanged" />
                <TextBox x:Name="PromptBox" Header="System prompt"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="260" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save prompt" Style="{StaticResource AccentButtonStyle}"
                            Click="SavePrompt_Click" />
                    <Button Content="Reset to default" Click="ResetPrompt_Click" />
                </StackPanel>
                <InfoBar x:Name="PromptBar" Severity="Success" IsOpen="False"
                         Message="Saved. It applies to your next message." />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
