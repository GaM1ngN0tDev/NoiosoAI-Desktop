<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NoiosoAI_Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NoiosoAI_Desktop"
    xmlns:ui="using:Windows.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Purple accent (replaces the default Windows blue) -->
            <ui:Color x:Key="SystemAccentColor">#7F67BE</ui:Color>
            <ui:Color x:Key="SystemAccentColorLight1">#9A86CF</ui:Color>
            <ui:Color x:Key="SystemAccentColorLight2">#B3A3DD</ui:Color>
            <ui:Color x:Key="SystemAccentColorLight3">#CDC2EA</ui:Color>
            <ui:Color x:Key="SystemAccentColorDark1">#6A52A8</ui:Color>
            <ui:Color x:Key="SystemAccentColorDark2">#553F8C</ui:Color>
            <ui:Color x:Key="SystemAccentColorDark3">#402F70</ui:Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#7F67BE" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#7F67BE" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#7F67BE" Opacity="0.8" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#7F67BE" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#7F67BE" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#7F67BE" Opacity="0.8" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#9A86CF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
